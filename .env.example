# Copy to .env for local development. wain-server reads it at startup.

# Local Postgres from scripts/dev-db.sh
DATABASE_URL=postgres://wain:wain@127.0.0.1:54320/wain

# Development mode: sign-in codes are shown in the browser and the server log
# instead of being emailed, and cookies work over plain http.
WAIN_DEV=1

# Enables AI design suggestions (billed to this key).
# ANTHROPIC_API_KEY=

# Or, to try the suggestions flow with fixed samples and no AI at all:
# WAIN_FAKE_AI=1

# Selling credits through Stripe Checkout. All three are needed. Each pack is
# `credits:price_id`, where the price is a one-time price created in Stripe;
# what it charges is read from Stripe. Point a Stripe webhook for
# `checkout.session.completed` and `checkout.session.async_payment_succeeded`
# at /api/v1/billing/webhook and put its signing secret here.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# WAIN_CREDIT_PACKS=25:price_xxx,100:price_yyy

# Or, to try the purchase flow with a sample pack that charges nothing:
# WAIN_FAKE_BILLING=1

# PORT=8787
# Required outside development mode (at least 32 characters):
# WAIN_SECRET=
